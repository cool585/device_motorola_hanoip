// Hanoip-only init files. The shared SM6150 init scripts (init.qcom.rc,
// init.mmi.rc, init.target.rc, ueventd.rc, ...) are provided by sm6150-common
// and select hanoip's sources via the `hanoip` soong_config bool.
prebuilt_etc {
    name: "init.hanoip.rc",
    src: "init.hanoip.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.mmi.overlay.rc",
    src: "init.mmi.overlay.rc",
    sub_dir: "init/hw",
    vendor: true,
}

sh_binary {
    name: "init.oem.fingerprint.sh",
    src: "init.oem.fingerprint.sh",
    vendor: true,
}

sh_binary {
    name: "init.oem.fingerprint2.sh",
    src: "init.oem.fingerprint2.sh",
    vendor: true,
}
