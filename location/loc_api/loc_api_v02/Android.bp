cc_library_shared {
    name: "libloc_api_v02",
    arch: {
        arm: {
            srcs: [
                "LocApiV02.cpp",
                "loc_api_v02_log.cpp",
                "loc_api_v02_client.cpp",
                "loc_api_sync_req.cpp",
                "location_service_v02.c",
            ],
        },
        arm64: {
            srcs: [
                "LocApiV02.cpp",
                "loc_api_v02_log.cpp",
                "loc_api_v02_client.cpp",
                "loc_api_sync_req.cpp",
                "location_service_v02.c",
            ],
        },
    },
    shared_libs: [
        "libutils",
        "libcutils",
        "libqmi_cci",
        "libqmi_common_so",
        "libloc_core",
        "libgps.utils",
        "libdl",
        "liblog",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    include_dirs: [
        "$(TARGET_OUT_HEADERS)/qmi-framework/inc",
        "$(TARGET_OUT_HEADERS)/qmi/inc",
    ],
    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "libqmi_common_headers",
        "libqmi_cci_headers",
    ],
    vendor: true,
}
