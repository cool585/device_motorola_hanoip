cc_library_shared {
    name: "libsynergy_loc_api",
    arch: {
        arm: {
            srcs: ["SynergyLocApi.cpp"],
        },
        arm64: {
            srcs: ["SynergyLocApi.cpp"],
        },
    },
    shared_libs: [
        "libutils",
        "libcutils",
        "libqmi_cci",
        "libqmi_common_so",
        "libloc_core",
        "libgps.utils",
        "libdl",
        "liblog",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "loc_sll_if_headers",
        "liblocation_api_headers",
    ],
    vendor: true,
    tags: ["optional"],
}

cc_library_headers {
    name: "libsynergyloc_api_headers",
    export_include_dirs: ["."],
    vendor: true,
}
